# Copy to .env for running manage.py outside Docker. docker-compose.yml sets
# its own development values and does not need this file.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://buffalo.example.org
DATABASE_URL=postgis://buffalo:buffalo@localhost:5432/buffalo
# smtp://user:password@host:587/?tls=True  (consolemail:// prints to stdout)
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=wyadapt-info@uwyo.edu
SUPPORT_EMAIL=wyadapt-info@uwyo.edu
# DJANGO_MEDIA_ROOT=/srv/buffalo/media
# ATTACHMENT_MAX_BYTES=2147483648
